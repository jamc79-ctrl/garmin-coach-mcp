# ============================================================
#  garmin.env · Credenciales de tu MCP de Garmin
# ============================================================
#  1. Guarda este archivo como "garmin.env" en la carpeta del repo
#     (junto a server.py).
#  2. Rellena los valores DESPUÉS del "=", sin espacios ni comillas.
#  3. NUNCA lo subas a GitHub ni lo pegues en un chat.
#     (.gitignore ya lo excluye: no uses "git add -f").
#  4. Protégelo (Mac/Linux):  chmod 600 garmin.env
#
#  Este MCP NO usa una "API key" de Garmin: entra en Garmin Connect
#  con tu email y contraseña (más el código MFA) y guarda unos
#  tokens que duran ~1 año.
# ============================================================

# --- Acceso a Garmin Connect (lo usa "python login_once.py") ---
# Tu email de Garmin Connect.
GARMIN_EMAIL=
# Tu contraseña de Garmin Connect.
# Consejo: déjala vacía y te la pedirá en la terminal sin mostrarla.
# Si la pones, bórrala de aquí cuando el login haya funcionado.
GARMIN_PASSWORD=

# --- Tokens de sesión (opcional) ---
# En local NO hace falta: login_once.py los guarda en
# ~/.garminconnect/garmin_tokens.json y el servidor los lee de ahí.
GARMIN_TOKENS_JSON=

# --- Contraseña del panel web (solo si lo publicas en internet) ---
# Genera una larga con:  openssl rand -hex 32
ADMIN_TOKEN=

# --- Preferencias (puedes dejarlas así) ---
GARMIN_TIMEZONE=Europe/Madrid
GARMIN_LANGUAGE=es
CACHE_MINUTES=30
